# Production settings. Load these into the process environment before npm start.
# Never commit a real .env or password.
ADMIN_PASSWORD=replace-with-a-long-unique-password
PUBLIC_URL=https://cards.yourcompany.com
HOST=127.0.0.1
PORT=3000
# Set this to a persistent disk when deployed. Defaults to ./data.
# DATA_DIR=/var/lib/mediallianz-cards

# Cloud deployment only: Supabase Connect > Transaction pooler (port 6543).
# Keep SSL enabled; URL-encode special characters in the database password.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?sslmode=require
SUPABASE_URL=https://PROJECT_REF.supabase.co
# Supabase secret key (or legacy service_role key), never a VITE_ variable.
SUPABASE_SECRET_KEY=replace-with-server-only-secret
